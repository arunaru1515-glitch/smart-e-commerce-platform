            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'testuser_' + Date.now() + '@gmail.com';",
                  "pm.collectionVariables.set('test_email', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const j = pm.response.json();",
